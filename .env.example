# Nexus Backend Configuration
# Copy this file to .env for local development.
# Never commit real secrets.

APP_NAME=Nexus Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

HOST=127.0.0.1
PORT=8000

LOG_LEVEL=INFO

# Future database configuration
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus

# Future cache / queue configuration
REDIS_URL=redis://localhost:6379/0

# Development placeholder only.
# Replace with a secure secret before any real deployment.
SECRET_KEY=change-me-in-development
